# ================================================================
# SkillMentor Backend Environment Variables (Render & Aiven MySQL)
# ================================================================

# Application Port (Render sets $PORT dynamically; 8080 by default)
PORT=8080

# ----------------------------------------------------------------
# Aiven MySQL Cloud Database Configuration
# ----------------------------------------------------------------
# Format: jdbc:mysql://<aiven-host>:<aiven-port>/<database-name>?sslMode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-xxxx.aivencloud.com:12345/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_aiven_mysql_password_here

# Hibernate DDL Auto: 'update' will auto-create all tables in Aiven MySQL on first boot
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Optional: Set to 'false' if you do not want initial demo users seeded in cloud DB
APP_SEED_ENABLED=true

# ----------------------------------------------------------------
# Security & JWT Configuration
# ----------------------------------------------------------------
# 256-bit or 512-bit hex secret key for signing JWT tokens
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ----------------------------------------------------------------
# CORS Allowed Origins
# ----------------------------------------------------------------
# Comma-separated origins. Include your Vercel production URL and preview wildcard:
CORS_ALLOWED_ORIGINS=https://skillmentor.vercel.app,https://*.vercel.app,http://localhost:5173

# ----------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode)
# ----------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
