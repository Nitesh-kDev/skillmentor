# ================================================================
# SkillMentor Frontend Environment Variables (Vercel)
# ================================================================

# Backend REST API Base URL (Point to your deployed Render service)
# Example: https://skillmentor-backend.onrender.com/api
VITE_API_BASE_URL=https://skillmentor-backend.onrender.com/api

# Optional: Dedicated WebSocket URL (Defaults to VITE_API_BASE_URL converted to /ws)
# VITE_WS_URL=https://skillmentor-backend.onrender.com/ws

# Optional: Dedicated Swagger UI URL
# VITE_SWAGGER_URL=https://skillmentor-backend.onrender.com/swagger-ui.html

# Razorpay Key ID for Client Checkout (Sandbox Key)
VITE_RAZORPAY_KEY_ID=your_razorpay_test_key_id
